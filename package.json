{
  "name": "one2md",
  "version": "0.2.1",
  "description": "Convert OneNote .one and .onepkg files to Markdown, entirely offline.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "one2md": "dist/one2md.mjs"
  },
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/cli.ts",
    "verify:upstream": "tsx scripts/verify-upstream.mjs",
    "skill:zip": "npm run build && cd skills && rm -f ../dist/onenote-to-markdown.zip && zip -qr ../dist/onenote-to-markdown.zip onenote-to-markdown -x \"*.DS_Store\"",
    "verify:officeimo": "tsx scripts/verify-officeimo.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.24.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
